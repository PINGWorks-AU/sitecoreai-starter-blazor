@inherits LayoutComponentBase

<SectionContent SectionName="HeadLayout">
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" media="print" onload="this.media='all'" />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i,800,800i&subset=cyrillic,cyrillic-ext,greek,greek-ext,latin-ext,vietnamese" media="print" onload="this.media='all'" />

	<link rel="stylesheet" href="@Assets["bootstrap-5.1.3.min.css"]">
	<link rel="stylesheet" href="@Assets["starterKit.css"]" />
	<link rel="stylesheet" href="@Assets["app.css"]" />
	<link rel="stylesheet" href="@Assets[$"{AssemblyName}.styles.css"]" />
</SectionContent>

@Body

<CookieConsent />

@code {
	private static string AssemblyName = System.Reflection.Assembly.GetEntryAssembly()?.GetName().Name ?? string.Empty;
}